{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "NodeNext",
		"target": "ES6",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "nodenext",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"lib": ["DOM", "ES5", "ES6", "ES7"],

		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
	},
	"include": ["src/**/*.ts", "vite.config.mts"]
}
